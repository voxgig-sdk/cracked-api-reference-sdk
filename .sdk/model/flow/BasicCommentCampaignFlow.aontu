# BasicCommentCampaignFlow

main: kit: flow: BasicCommentCampaignFlow:
{
  entity: "comment_campaign",
  kind: "basic",
  name: "BasicCommentCampaignFlow",
  step: [
    {
      i: {
        ref: "comment_campaign_ref01"
      }

      m: {
        product_id: "product01"
      }

      o: "create"
    }

    {
      i: {
        ref: "comment_campaign_ref01",
        srcdatavar: "comment_campaign_ref01_data",
        suffix: "_up0",
        textfield: "action"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-comment_campaign_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "comment_campaign_ref01",
        srcdatavar: "comment_campaign_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "comment_campaign01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-comment_campaign_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommentCampaignFlow"
}