# BasicIrisConnectorFlow

main: kit: flow: BasicIrisConnectorFlow:
{
  entity: "iris_connector",
  kind: "basic",
  name: "BasicIrisConnectorFlow",
  step: [
    {
      i: {
        ref: "iris_connector_ref01"
      }

      m: {
        connector_id: "connector01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "iris_connector_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIrisConnectorFlow"
}