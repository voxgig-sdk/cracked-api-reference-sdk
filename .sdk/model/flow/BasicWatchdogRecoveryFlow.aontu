# BasicWatchdogRecoveryFlow

main: kit: flow: BasicWatchdogRecoveryFlow:
{
  entity: "watchdog_recovery",
  kind: "basic",
  name: "BasicWatchdogRecoveryFlow",
  step: [
    {
      i: {
        ref: "watchdog_recovery_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "watchdog_recovery_ref01",
        srcdatavar: "watchdog_recovery_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-watchdog_recovery_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWatchdogRecoveryFlow"
}