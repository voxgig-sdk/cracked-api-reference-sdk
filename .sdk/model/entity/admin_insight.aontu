    }
    membership: {
      h: "Membership"
      n: "membership"
      r: false
      t: "`$ANY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    notification_count: {
      h: "Notification Count"
      n: "notification_count"
      r: true
      t: "`$INTEGER`"
    }
    notification_events: {
      h: "Notification Events"
      n: "notification_events"
      r: true
      t: "`$ARRAY`"
    }
    priority: {
      h: "Priority"
      n: "priority"
      r: true
      t: "`$STRING`"
    }
    severity: {
      h: "Severity"
      n: "severity"
      r: true
      t: "`$STRING`"
    }
    status_label: {
      h: "Status Label"
      n: "status_label"
      r: true
      t: "`$STRING`"
    }
    subscription_current_period_end: {
      h: "Subscription Current Period End"
      n: "subscription_current_period_end"
