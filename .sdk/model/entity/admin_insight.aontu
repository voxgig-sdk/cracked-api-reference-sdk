    user_id: {
      fo: "uuid"
      h: "User Id"
      n: "user_id"
      r: true
      t: "`$STRING`"
    }
  }

  name: "admin_insight"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/admin/insights"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/admin/insights"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "admin"
            }
            {
              lit: "insights"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.customer_success_cases`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/admin/insights/customer-agent-readiness"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "customer_email"
                or: "customer_emails"
                r: false
                t: "`$ANY`"
              }
              {
                ex: true
                k: "query"
                n: "include_agent"
                or: "include_agents"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                ex: 500
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/admin/insights/customer-agent-readiness"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "admin"
            }
            {
              lit: "insights"
            }
            {
              lit: "customer-agent-readiness"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



