      t: "`$STRING`"
    }
    days_until_period_end: {
      h: "Days Until Period End"
      n: "days_until_period_end"
      r: false
      t: "`$ANY`"
    }
    email: {
      h: "Email"
      n: "email"
      r: true
      t: "`$STRING`"
    }
    feature_impact: {
      h: "Feature Impact"
      n: "feature_impact"
      r: true
      t: "`$STRING`"
    }
    last_notification_at: {
      h: "Last Notification At"
      n: "last_notification_at"
      r: false
