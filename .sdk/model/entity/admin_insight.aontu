# Entity: admin_insight

main: kit: entity: admin_insight: {

  alias: field: {}

  fields: {
    active_agents: {
      h: "Active Agents"
      n: "active_agents"
      r: true
      t: "`$INTEGER`"
    }
    active_products: {
      h: "Active Products"
      n: "active_products"
      r: true
      t: "`$INTEGER`"
    }
    agents_count: {
      h: "Agents Count"
      n: "agents_count"
