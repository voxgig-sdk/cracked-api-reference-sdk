# Entity: create_variation

main: kit: entity: create_variation: {

  alias: field: {}

  fields: {
    hook_duration: {
      h: "Hook Duration"
      n: "hook_duration"
      r: true
      t: "`$INTEGER`"
    }
    media_asset_id: {
      fo: "uuid"
      h: "Media Asset Id"
      n: "media_asset_id"
      r: true
      t: "`$STRING`"
    }
    message: {
      h: "Message"
      n: "message"
      r: true
      t: "`$STRING`"
    }
    product_id: {
