    video_id: {
      fo: "uuid"
      h: "Video Id"
      n: "video_id"
      r: true
      t: "`$STRING`"
    }
  }

  name: "create_variation"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "hook_duration"
            "media_asset_id"
            "product_id"
            "prompt"
          ]
          co: {
            id: "POST /api/video-variation/create-hook"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/video-variation/create-hook"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "video-variation"
            }
            {
              lit: "create-hook"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "media_asset_id"
            "product_id"
          ]
          co: {
            id: "POST /api/video-variation/create-invisible"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/video-variation/create-invisible"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
