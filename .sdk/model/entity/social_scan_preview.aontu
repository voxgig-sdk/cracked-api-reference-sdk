# Entity: social_scan_preview

main: kit: entity: social_scan_preview: {

  alias: field: {}

  fields: {
    instagram_handle: {
      h: "Instagram Handle"
      n: "instagram_handle"
      r: false
      sh: "Instagram username/handle to scrape"
      t: "`$ANY`"
    }
    posts: {
      h: "Posts"
      n: "posts"
      r: true
      t: "`$ARRAY`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      t: "`$BOOLEAN`"
    }
    tiktok_handle: {
      h: "Tiktok Handle"
      n: "tiktok_handle"
      r: false
      sh: "TikTok username/handle to scrape"
      t: "`$ANY`"
    }
  }

  name: "social_scan_preview"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "instagram_handle"
            "tiktok_handle"
          ]
          co: {
            id: "POST /api/social-scan/preview"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/social-scan/preview"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "social-scan"
            }
            {
              lit: "preview"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
